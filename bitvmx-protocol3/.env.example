# BitVMX Protocol 환경설정
# 이 파일을 .env로 복사하여 사용하세요

# 네트워크 설정
NETWORK=mutinynet

# Bitcoin 노드 설정 (MutinyNet)
BITCOIN_RPC_URL=https://mutinynet.com/api
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# 프라이빗 키 (테스트용 - 실제 자금 사용 금지!)
# 아래는 예시 키입니다. 실제 사용시 변경하세요.
PRIVATE_KEY=d8a1e1224e63135765bde9dc8a2c8e403eee8be73d3589d58c5ddbf9dce3fdf4

# 주소 (위 프라이빗 키에 대응)
ADDRESS=tb1qt8rdur557nz338g3lekc6458pj0dl63c0s9904

# BitVMX 설정
BITVMX_PROVER_URL=http://localhost:8081
BITVMX_VERIFIER_URL=http://localhost:8080

# Oracle 설정 (옵션 가격 데이터)
BINANCE_API_URL=https://api.binance.com/api/v3
COINBASE_API_URL=https://api.coinbase.com/v2
KRAKEN_API_URL=https://api.kraken.com/0

# 옵션 설정 기본값
DEFAULT_OPTION_TYPE=CALL
DEFAULT_STRIKE_PRICE=120000
DEFAULT_EXPIRY_DAYS=3
DEFAULT_UNIT_BTC=0.01

# 수수료 설정 (satoshis)
TX_FEE=500
ANCHOR_FEE=300

# 로깅
LOG_LEVEL=INFO